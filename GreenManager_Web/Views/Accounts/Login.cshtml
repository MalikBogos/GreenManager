@model GreenManager_Web.Models.LoginViewModel

@{
    ViewData["Title"] = SR["LoginTitle"];
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0">
            <div class="card-body p-5">
                <h2 class="text-center mb-4 text-primary">@SR["LoginTitle"]</h2>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">@SR["Email"]</label>
                        <input asp-for="Email" class="form-control" placeholder="@SR["EmailPlaceholder"]" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">@SR["Password"]</label>
                        <input asp-for="Password" class="form-control" placeholder="@SR["PasswordPlaceholder"]" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">@SR["RememberMe"]</label>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">@SR["BtnLogin"]</button>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="mb-0">@SR["NoAccountYet"] <a asp-action="Register" class="text-decoration-none">@SR["RegisterHere"]</a>.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}