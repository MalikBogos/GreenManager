<Window x:Class="GreenManager_WPF.Views.AddMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuw Materiaal Toevoegen" Height="600" Width="450"
        WindowStartupLocation="CenterOwner" Background="white"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Nieuw Materiaal" Style="{StaticResource HeaderStyle}"/>

		<StackPanel Grid.Row="1">
			<TextBlock Text="Artikelnaam *"/>
			<TextBox Text="{Binding NewMaterial.Name}"/>

			<TextBlock Text="Omschrijving (Optioneel)"/>
			<TextBox Text="{Binding NewMaterial.Description}" Height="50" TextWrapping="Wrap"/>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<TextBlock Text="Prijs *"/>
					<TextBox Text="{Binding NewMaterial.PurchasePrice}"/>
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock Text="Voorraad *"/>
					<TextBox Text="{Binding NewMaterial.StockQuantity}"/>
				</StackPanel>
			</Grid>

			<TextBlock Text="Eenheid (bijv. Stuk, m2)"/>
			<TextBox Text="{Binding NewMaterial.Unit}"/>

			<TextBlock Text="Interne Notities (Optioneel)"/>
			<TextBox Text="{Binding NewMaterial.Notes}" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Annuleren" Style="{StaticResource CancelButtonStyle}" Click="BtnCancel_Click"/>
			<Button Content="Opslaan" Style="{StaticResource SaveButtonStyle}" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>