<Window x:Class="GreenManager___WPF.Views.EditMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materiaal Bewerken" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA"
        ResizeMode="NoResize">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Materiaal Bewerken" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

		<StackPanel Grid.Row="1">
			<TextBlock Text="Artikelnaam *" FontWeight="Bold"/>
			<TextBox Text="{Binding EditedMaterial.Name}" Margin="0,5,0,15" Padding="5"/>

			<TextBlock Text="Omschrijving (Optioneel)"/>
			<TextBox Text="{Binding EditedMaterial.Description}" Height="50" TextWrapping="Wrap" Margin="0,5,0,15" Padding="5"/>

			<Grid Margin="0,0,0,15">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<TextBlock Text="Prijs *"/>
					<TextBox Text="{Binding EditedMaterial.PurchasePrice}" Margin="0,5,0,0" Padding="5"/>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<TextBlock Text="Voorraad *"/>
					<TextBox Text="{Binding EditedMaterial.StockQuantity}" Margin="0,5,0,0" Padding="5"/>
				</StackPanel>
			</Grid>

			<TextBlock Text="Eenheid (bijv. Stuk, m2)"/>
			<TextBox Text="{Binding EditedMaterial.Unit}" Margin="0,5,0,15" Padding="5"/>

			<TextBlock Text="Interne Notities (Optioneel)"/>
			<TextBox Text="{Binding EditedMaterial.Notes}" Height="Auto" TextWrapping="Wrap" Margin="0,5,0,15" Padding="5" TextChanged="TextBox_TextChanged"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Annuleren" Width="100" Padding="10" Margin="0,0,10,0" Background="#E74C3C" Foreground="White" Click="BtnCancel_Click"/>
			<Button Content="Opslaan" Width="100" Padding="10" Background="#27AE60" Foreground="White" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>