<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GreenManager_App.ViewModels"
             x:Class="GreenManager_App.Views.Materials.MaterialDetailsPage"
             x:DataType="viewmodels:MaterialsViewModel"
             Title="Details">
	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="15">
			<Label Text="{Binding SelectedMaterial.Name}" FontSize="24" FontAttributes="Bold" TextColor="DarkGreen" />

			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Beheer:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedMaterial.StockQuantity, StringFormat='Voorraad: {0}'}" />
					<Label Text="{Binding SelectedMaterial.Unit, StringFormat='Eenheid: {0}'}" />
					<Label Text="{Binding SelectedMaterial.PurchasePrice, StringFormat='Aankoopprijs: €{0}'}" />
				</VerticalStackLayout>
			</Border>

			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Informatie:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedMaterial.Description, StringFormat='Beschrijving: {0}'}" />
					<Label Text="{Binding SelectedMaterial.Notes, StringFormat='Notities: {0}'}" Margin="0,10,0,0" />
				</VerticalStackLayout>
			</Border>

			<Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
				<Button Grid.Column="0" Text="Bewerken" Command="{Binding NavigateToEditMaterialCommand}" BackgroundColor="Orange" TextColor="White" />
				<Button Grid.Column="1" Text="Verwijderen" Command="{Binding DeleteMaterialCommand}" BackgroundColor="DarkRed" TextColor="White" />
			</Grid>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>