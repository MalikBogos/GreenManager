@using Microsoft.AspNetCore.Identity
@using Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center">
            <!-- Mooie outline knop voor uitloggen -->
            <form asp-controller="Accounts" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-light fw-bold">
                    <i class="bi bi-box-arrow-right"></i> @SR["NavLogout"]
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white fw-bold" asp-controller="Accounts" asp-action="Register">
                <i class="bi bi-person-plus"></i> @SR["NavRegister"]
            </a>
        </li>
        <li class="nav-item ms-1">
            <a class="btn btn-sm btn-light text-success fw-bold mt-1" asp-controller="Accounts" asp-action="Login">
                <i class="bi bi-box-arrow-in-right"></i> @SR["NavLogin"]
            </a>
        </li>
    }
</ul>