<Window x:Class="GreenManager_WPF.Views.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuwe Werknemer Toevoegen" Height="800" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Nieuwe Werknemer" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
		</StackPanel>

		<StackPanel Grid.Row="1">
			<TextBlock Text="Personeelsnummer (Automatisch gegenereerd)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
			<TextBox Text="{Binding NewEmployee.EmployeeNumber}" 
                     IsReadOnly="True" Background="#E8ECEF" Foreground="#7F8C8D"
                     Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Voornaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding UserFirstName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Achternaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding UserLastName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

			<TextBlock Text="E-mailadres (Voor inloggen) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Functie (Job Title) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding NewEmployee.JobTitle}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Datum indiensttreding *" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<DatePicker SelectedDate="{Binding NewEmployee.HireDate}" Padding="5" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Annuleren" Width="100" Padding="10" Margin="0,0,10,0" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
			<Button Content="Opslaan" Width="120" Padding="10" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>