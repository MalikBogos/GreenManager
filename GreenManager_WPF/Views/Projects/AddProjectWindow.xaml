<Window x:Class="GreenManager_WPF.Views.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuw Project / Offerte Aanmaken" Height="700" Width="500"
        WindowStartupLocation="CenterOwner" Background="White"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Nieuw Project / Offerte" Style="{StaticResource HeaderStyle}"/>
			<TextBlock Text="Koppel een bestaande klant om te beginnen." Foreground="Gray" FontWeight="Normal"/>
		</StackPanel>

		<StackPanel Grid.Row="1">
			<TextBlock Text="Klant Selecteren *"/>
			<ComboBox ItemsSource="{Binding AvailableCustomers}"
                      SelectedValue="{Binding NewProject.CustomerId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="LastName"/>

			<TextBlock Text="Projectnaam *"/>
			<TextBox Text="{Binding NewProject.Name}"/>

			<TextBlock Text="Adres van het project"/>
			<TextBox Text="{Binding NewProject.ProjectAddress}"/>

			<TextBlock Text="Startdatum"/>
			<DatePicker SelectedDate="{Binding NewProject.StartDate}"/>

			<TextBlock Text="Budget / Offerte (€)"/>
			<TextBox Text="{Binding NewProject.Budget}"/>

			<TextBlock Text="Korte Omschrijving"/>
			<TextBox Text="{Binding NewProject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Annuleren" Style="{StaticResource CancelButtonStyle}" Click="BtnCancel_Click"/>
			<Button Content="Aanmaken" Style="{StaticResource SaveButtonStyle}" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>