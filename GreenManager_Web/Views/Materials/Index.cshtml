@model IEnumerable<Models.Entities.Material>

@{
    ViewData["Title"] = SR["NavMaterials"];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h2 text-dark fw-bold">@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> @SR["AddMaterial"]
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@SR["Name"]</th>
                            <th>@SR["Description"]</th>
                            <th>@SR["Unit"]</th>
                            <th>@SR["PurchasePrice"]</th>
                            <th>@SR["StockQuantity"]</th>
                            <th>@SR["Notes"]</th>
                            <th class="text-end pe-3">@SR["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.Name</td>
                                <td class="align-middle">@item.Description</td>
                                <td class="align-middle">@item.Unit</td>
                                <td class="align-middle">@item.PurchasePrice</td>
                                <td class="align-middle">@item.StockQuantity</td>
                                <td class="align-middle">@item.Notes</td>
                                <td class="text-end align-middle pe-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">@SR["Edit"]</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">@SR["Details"]</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@SR["Delete"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>