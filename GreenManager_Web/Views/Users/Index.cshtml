@model IEnumerable<GreenManager_Web.Models.UserViewModel>

@{
    ViewData["Title"] = SR["Users"];
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-light">
            <tr>
                <th>@SR["FirstName"]</th>
                <th>@SR["LastName"]</th>
                <th>@SR["Email"]</th>
                <th>@SR["Role"]</th>
                <th>@SR["IsBlocked"]</th>
                <th>@SR["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td><span class="badge bg-secondary">@user.Role</span></td>
                    <td>
                        @if (user.IsBlocked)
                        {
                            <span class="badge bg-danger">@SR["Yes"]</span>
                        }
                        else
                        {

                            <span class="badge bg-success">@SR["No"]</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">@SR["Edit"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>