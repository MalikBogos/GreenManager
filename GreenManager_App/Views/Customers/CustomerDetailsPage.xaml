<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GreenManager_App.ViewModels"
             x:Class="GreenManager_App.Views.Customers.CustomerDetailsPage"
             x:DataType="viewmodels:CustomersViewModel"
             Title="Klant Details">

	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="15">

			<Label Text="{Binding SelectedCustomer.FirstName, StringFormat='Profiel van: {0}'}" FontSize="24" FontAttributes="Bold" TextColor="DarkGreen" />

			<!-- Naam & Bedrijf -->
			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Persoonlijk &amp; Bedrijf:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedCustomer.FirstName, StringFormat='Voornaam: {0}'}" />
					<Label Text="{Binding SelectedCustomer.LastName, StringFormat='Achternaam: {0}'}" />

					<Label Text="{Binding SelectedCustomer.CompanyName, StringFormat='Bedrijf: {0}'}" Margin="0,5,0,0"/>
					<Label Text="{Binding SelectedCustomer.VATNumber, StringFormat='BTW: {0}'}" />
				</VerticalStackLayout>
			</Border>

			<!-- Contactgegevens -->
			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Contact:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedCustomer.Email, StringFormat='E-mail: {0}'}" />
					<Label Text="{Binding SelectedCustomer.PhoneNumber, StringFormat='Tel: {0}'}" />
				</VerticalStackLayout>
			</Border>

			<!-- Adres -->
			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Adres:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedCustomer.Street}" />
					<HorizontalStackLayout Spacing="5">
						<Label Text="{Binding SelectedCustomer.PostalCode}" />
						<Label Text="{Binding SelectedCustomer.City}" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>

			<!-- Extra Notities -->
			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Notities:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedCustomer.Notes}" />
				</VerticalStackLayout>
			</Border>

			<!-- Knoppen voor Acties -->
			<Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
				<Button Grid.Column="0" 
                        Text="Bewerken" 
                        Command="{Binding NavigateToEditCustomerCommand}" 
                        BackgroundColor="Orange" 
                        TextColor="White" />

				<Button Grid.Column="1" 
                        Text="Verwijderen" 
                        Command="{Binding DeleteCustomerCommand}" 
                        BackgroundColor="DarkRed" 
                        TextColor="White" />
			</Grid>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>