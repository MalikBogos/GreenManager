@model IEnumerable<Models.Entities.Customer>

@{
    ViewData["Title"] = "Klantenoverzicht";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2 text-dark font-weight-bold">Klantenoverzicht</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nieuwe Klant Toevoegen
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Voornaam</th>
                            <th>Achternaam</th>
                            <th>Bedrijfsnaam</th>
                            <th>E-mailadres</th>
                            <th>Telefoonnummer</th>
                            <th>Stad</th>
                            <th class="text-end pe-3">Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    Geen actieve klanten gevonden in het systeem.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-middle">@item.FirstName</td>
                                    <td class="align-middle fw-bold">@item.LastName</td>
                                    <td class="align-middle">@(item.CompanyName ?? "-")</td>
                                    <td class="align-middle">@item.Email</td>
                                    <td class="align-middle">@item.PhoneNumber</td>
                                    <td class="align-middle">@(item.City ?? "-")</td>
                                    <td class="text-end align-middle pe-3">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                            Bewerken
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1">
                                            Details
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            Verwijderen
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>