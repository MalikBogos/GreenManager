<Window x:Class="GreenManager_WPF.Views.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Werknemer Bewerken" Height="750" Width="500"
        WindowStartupLocation="CenterOwner" Background="White"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Werknemer Bewerken" Style="{StaticResource HeaderStyle}"/>
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
			<StackPanel>
				<TextBlock Text="Werkgegevens" FontSize="18"/>

				<TextBlock Text="Personeelsnummer (Niet bewerkbaar)" Foreground="Gray"/>
				<TextBox Text="{Binding EditedEmployee.EmployeeNumber}" IsReadOnly="True" Background="LightGray" Foreground="Gray"/>

				<TextBlock Text="Gebruikersrol (Rechten) *"/>
				<ComboBox ItemsSource="{Binding AvailableRoles}" SelectedValue="{Binding SelectedRoleId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>

				<TextBlock Text="Uurloon (€) *"/>
				<TextBox Text="{Binding EditedEmployee.HourlyWage}"/>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<TextBlock Text="Functie *"/>
						<TextBox Text="{Binding EditedEmployee.JobTitle}"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<TextBlock Text="Telefoonnummer"/>
						<TextBox Text="{Binding EditedPhoneNumber}"/>
					</StackPanel>
				</Grid>

				<TextBlock Text="Datum indiensttreding *"/>
				<DatePicker SelectedDate="{Binding EditedEmployee.HireDate}"/>

				<TextBlock Text="Persoonlijke Gegevens" FontSize="18"/>

				<TextBlock Text="Voornaam *"/>
				<TextBox Text="{Binding EditedFirstName}"/>

				<TextBlock Text="Achternaam *"/>
				<TextBox Text="{Binding EditedLastName}"/>

				<TextBlock Text="Geboortedatum"/>
				<DatePicker SelectedDate="{Binding EditedEmployee.DateOfBirth}"/>

				<TextBlock Text="Adresgegevens" FontSize="18"/>

				<TextBlock Text="Straat en Huisnummer"/>
				<TextBox Text="{Binding EditedEmployee.Street}"/>

				<Grid Margin="0,0,0,15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="2*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0">
						<TextBlock Text="Postcode"/>
						<TextBox Text="{Binding EditedEmployee.PostalCode}"/>
					</StackPanel>
					<StackPanel Grid.Column="2">
						<TextBlock Text="Plaats"/>
						<TextBox Text="{Binding EditedEmployee.City}"/>
					</StackPanel>
				</Grid>

				<TextBlock Text="Interne Notities" FontSize="18"/>
				<TextBox Text="{Binding EditedEmployee.Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top"/>
			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Annuleren" Style="{StaticResource CancelButtonStyle}" Click="BtnCancel_Click"/>
			<Button Content="Opslaan" Style="{StaticResource SaveButtonStyle}" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>