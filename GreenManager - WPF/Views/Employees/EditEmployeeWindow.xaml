<Window x:Class="GreenManager___WPF.Views.EditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Werknemer Bewerken" Height="1200" Width="500"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="👷 Werknemer Bewerken" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
			<StackPanel>

				<TextBlock Text="💼 Werkgegevens" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

				<TextBlock Text="Personeelsnummer (Niet bewerkbaar)" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#7F8C8D"/>
				<TextBox Text="{Binding EditedEmployee.EmployeeNumber}" IsReadOnly="True" Background="#E8ECEF" Foreground="#7F8C8D" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<TextBlock Text="Gebruikersrol (Rechten) *" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<ComboBox ItemsSource="{Binding AvailableRoles}" 
                          SelectedValue="{Binding SelectedRoleId}" 
                          SelectedValuePath="Id" 
                          DisplayMemberPath="Name" 
                          Padding="6" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<Grid Margin="0,0,0,15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="10"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0">
						<TextBlock Text="Functie *" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding EditedEmployee.JobTitle}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
					</StackPanel>

					<StackPanel Grid.Column="2">
						<TextBlock Text="Afdeling" FontWeight="SemiBold" Margin="0,0,0,5"/>
						<TextBox Text="{Binding EditedEmployee.Department}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
					</StackPanel>
				</Grid>

				<TextBlock Text="Datum indiensttreding *" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<DatePicker SelectedDate="{Binding EditedEmployee.HireDate}" Padding="5" Margin="0,0,0,25" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<TextBlock Text="👤 Persoonlijke Gegevens" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

				<TextBlock Text="Voornaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<TextBox Text="{Binding EditedFirstName}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<TextBlock Text="Achternaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<TextBox Text="{Binding EditedLastName}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<TextBlock Text="Geboortedatum" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<DatePicker SelectedDate="{Binding EditedEmployee.DateOfBirth}" Padding="5" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<TextBlock Text="Noodcontact Naam" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<TextBox Text="{Binding EditedEmployee.EmergencyContactName}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<TextBlock Text="Noodcontact Telefoon" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<TextBox Text="{Binding EditedEmployee.EmergencyContactPhone}" Padding="8" Margin="0,0,0,25" BorderThickness="1" BorderBrush="#DCDDE1"/>

				<!-- Address-->

				<TextBlock Text="Adresgegevens" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                
                <TextBlock Text="Straat en Huisnummer" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditedEmployee.Street}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Postcode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditedEmployee.PostalCode}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Plaats" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditedEmployee.City}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
                    </StackPanel>
                </Grid>

				<TextBlock Text="📝 Interne Notities" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
				<TextBox Text="{Binding EditedEmployee.Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>

			</StackPanel>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Annuleren" Width="100" Padding="10" Margin="0,0,10,0" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>

			<Button Content="Opslaan" Width="120" Padding="10" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>