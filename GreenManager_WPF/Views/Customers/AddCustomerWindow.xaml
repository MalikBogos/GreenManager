<Window x:Class="GreenManager_WPF.Views.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuwe Klant Toevoegen" Height="700" Width="700"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Nieuwe Klant Registreren" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
			<TextBlock Text="Velden gemarkeerd met een * zijn verplicht volgens het systeem." Foreground="#7F8C8D"/>
		</StackPanel>

		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="30"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,15">
					<TextBlock Text="Voornaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.FirstName}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,15">
					<TextBlock Text="Bedrijfsnaam (Optioneel)" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.CompanyName}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,15">
					<TextBlock Text="Achternaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.LastName}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,15">
					<TextBlock Text="BTW Nummer (Optioneel)" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.VATNumber}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,15">
					<TextBlock Text="E-mailadres *" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.Email}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,15">
					<TextBlock Text="Telefoonnummer *" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.PhoneNumber}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<Border Grid.Row="3" Grid.ColumnSpan="3" Height="1" Background="#DCDDE1" Margin="0,10,0,20"/>

				<TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="Adresgegevens" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

				<StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,15">
					<TextBlock Text="Straat en Huisnummer" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.Street}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>

				<StackPanel Grid.Row="5" Grid.Column="2" Margin="0,0,0,15">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="10"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0">
							<TextBlock Text="Postcode" FontWeight="SemiBold" Margin="0,0,0,5"/>
							<TextBox Text="{Binding NewCustomer.PostalCode}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
						</StackPanel>
						<StackPanel Grid.Column="2">
							<TextBlock Text="Plaats" FontWeight="SemiBold" Margin="0,0,0,5"/>
							<TextBox Text="{Binding NewCustomer.City}" Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
						</StackPanel>
					</Grid>
				</StackPanel>

				<StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,10">
					<TextBlock Text="Interne Notities" FontWeight="SemiBold" Margin="0,0,0,5"/>
					<TextBox Text="{Binding NewCustomer.Notes}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="100"
                             VerticalContentAlignment="Top"
                             Padding="8" BorderThickness="1" BorderBrush="#DCDDE1"/>
				</StackPanel>
			</Grid>
		</ScrollViewer>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Annuleren" Width="120" Padding="10" Margin="0,0,10,0" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="BtnCancel_Click"/>
			<Button Content="Klant Opslaan" Width="150" Padding="10" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>