<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GreenManager_App.ViewModels"
             x:Class="GreenManager_App.Views.Materials.EditMaterialPage"
             x:DataType="viewmodels:MaterialsViewModel"
             Title="Materiaal Bewerken">
	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="15">
			<Label Text="Materiaalinformatie" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen" />
			<Entry Placeholder="Naam *" Text="{Binding SelectedMaterial.Name}" />
			<Entry Placeholder="Eenheid (bijv. stuks, m2)" Text="{Binding SelectedMaterial.Unit}" />

			<Label Text="Financieel &amp; Voorraad" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen" Margin="0,10,0,0"/>
			<Entry Placeholder="Aankoopprijs (€)" Text="{Binding SelectedMaterial.PurchasePrice}" Keyboard="Numeric" />
			<Entry Placeholder="Huidige Voorraad" Text="{Binding SelectedMaterial.StockQuantity}" Keyboard="Numeric" />

			<Label Text="Extra Details" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen" Margin="0,10,0,0"/>
			<Editor Placeholder="Korte omschrijving" Text="{Binding SelectedMaterial.Description}" HeightRequest="60" />
			<Editor Placeholder="Notities" Text="{Binding SelectedMaterial.Notes}" HeightRequest="100" />

			<Label Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" FontAttributes="Bold" />
			<Button Text="Opslaan" Command="{Binding UpdateMaterialCommand}" BackgroundColor="Orange" TextColor="White" CornerRadius="8" Margin="0,15,0,20"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>