@model Models.Entities.Material

@{
    ViewData["Title"] = SR["Details"];
}

<div class="container mt-4">
    <h2>@ViewData["Title"]: @Model.Name</h2>
    <hr />

    <dl class="row mt-4">
        <dt class="col-sm-3 fw-bold">@SR["Name"]</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3 fw-bold">@SR["Description"]</dt>
        <dd class="col-sm-9">@(Model.Description ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["Unit"]</dt>
        <dd class="col-sm-9">@(Model.Unit ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["PurchasePrice"]</dt>
        <dd class="col-sm-9">€@Model.PurchasePrice.ToString("G")</dd>

        <dt class="col-sm-3 fw-bold">@SR["StockQuantity"]</dt>
        <dd class="col-sm-9">@Model.StockQuantity @Model.Unit</dd>

        <dt class="col-sm-3 fw-bold">@SR["Notes"]</dt>
        <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
    </dl>

    <div class="mt-4 mb-5">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">@SR["BtnEdit"]</a>
        <a asp-action="Index" class="btn btn-secondary">@SR["BackToList"]</a>
    </div>
</div>