@model GreenManager_Web.Models.EmployeeCreateViewModel

@{
    ViewData["Title"] = SR["AddEmployee"];
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h2 text-dark fw-bold">@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @SR["BackToList"]
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white fw-bold">
            @SR["GeneralAndHRInfo"]
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="row">
                    <!-- ReadOnly gegenereerd EmployeeNumber -->
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold text-muted">@SR["EmployeeNumber"]</label>
                        <input asp-for="EmployeeNumber" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-12 mt-2 mb-2">
                        <h5 class="fw-bold border-bottom pb-2">@SR["IdentityAndLogin"]</h5>
                        <small class="text-muted">@SR["AutoPasswordMessage"] <b>Welcome123!</b></small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="FirstName" class="form-label fw-bold">@SR["FirstName"] *</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="LastName" class="form-label fw-bold">@SR["LastName"] *</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Email" class="form-label fw-bold">@SR["Email"] *</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-12 mt-3 mb-2">
                        <h5 class="fw-bold border-bottom pb-2">@SR["ContractDetails"]</h5>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="JobTitle" class="form-label fw-bold">@SR["JobTitle"] *</label>
                        <input asp-for="JobTitle" class="form-control" />
                        <span asp-validation-for="JobTitle" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="HourlyWage" class="form-label fw-bold">@SR["HourlyWage"] *</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input asp-for="HourlyWage" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="HourlyWage" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="HireDate" class="form-label fw-bold">@SR["HireDate"] *</label>
                        <input asp-for="HireDate" type="date" class="form-control" />
                        <span asp-validation-for="HireDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="DateOfBirth" class="form-label fw-bold">@SR["DateOfBirth"]</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                    </div>

                    <div class="col-12 mt-3 mb-2">
                        <h5 class="fw-bold border-bottom pb-2">@SR["Address"]</h5>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label for="Street" class="form-label fw-bold">@SR["Street"]</label>
                        <input asp-for="Street" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="PostalCode" class="form-label fw-bold">@SR["PostalCode"]</label>
                        <input asp-for="PostalCode" class="form-control" />
                    </div>
                    <div class="col-md-8 mb-3">
                        <label for="City" class="form-label fw-bold">@SR["City"]</label>
                        <input asp-for="City" class="form-control" />
                    </div>

                    <div class="col-12 mb-4 mt-2">
                        <label for="Notes" class="form-label fw-bold">@SR["Notes"]</label>
                        <textarea asp-for="Notes" class="form-control bg-light" rows="3"></textarea>
                    </div>

                    <div class="col-12 text-end border-top pt-3">
                        <button type="submit" class="btn btn-success px-4 fw-bold">@SR["Save"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}