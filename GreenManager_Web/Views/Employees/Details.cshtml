@model Models.Entities.Employee

@{
    ViewData["Title"] = SR["Details"];
}

<div class="container mt-4">
    <h2>@ViewData["Title"]: @Model.User?.FirstName @Model.User?.LastName</h2>
    <hr />

    <dl class="row mt-4">
        <dt class="col-sm-3 fw-bold">@SR["EmployeeNumber"]</dt>
        <dd class="col-sm-9">@Model.EmployeeNumber</dd>

        <dt class="col-sm-3 fw-bold">@SR["FirstName"]</dt>
        <dd class="col-sm-9">@Model.User?.FirstName</dd>

        <dt class="col-sm-3 fw-bold">@SR["LastName"]</dt>
        <dd class="col-sm-9">@Model.User?.LastName</dd>

        <dt class="col-sm-3 fw-bold">@SR["Email"]</dt>
        <dd class="col-sm-9">@Model.User?.Email</dd>

        <dt class="col-sm-3 fw-bold">@SR["PhoneNumber"]</dt>
        <dd class="col-sm-9">@(Model.User?.PhoneNumber ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["JobTitle"]</dt>
        <dd class="col-sm-9">@Model.JobTitle</dd>

        <dt class="col-sm-3 fw-bold">@SR["HourlyWage"]</dt>
        <dd class="col-sm-9">€@Model.HourlyWage.ToString("G")</dd>

        <dt class="col-sm-3 fw-bold">@SR["HireDate"]</dt>
        <dd class="col-sm-9">@Model.HireDate.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-3 fw-bold">@SR["DateOfBirth"]</dt>
        <dd class="col-sm-9">@(Model.DateOfBirth?.ToString("dd-MM-yyyy") ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["Street"]</dt>
        <dd class="col-sm-9">@(Model.Street ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["PostalCode"]</dt>
        <dd class="col-sm-9">@(Model.PostalCode ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["City"]</dt>
        <dd class="col-sm-9">@(Model.City ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["Notes"]</dt>
        <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
    </dl>

    <div class="mt-4 mb-5">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">@SR["BtnEdit"]</a>
        <a asp-action="Index" class="btn btn-secondary">@SR["BackToList"]</a>
    </div>
</div>