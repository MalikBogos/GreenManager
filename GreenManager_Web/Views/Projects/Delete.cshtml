@model Models.Entities.Project

@{
    ViewData["Title"] = SR["BtnDelete"];
}

<div class="container mt-4">
    <h2 class="text-danger">@ViewData["Title"]</h2>
    <h4>@SR["AreYouSureDelete"]</h4>
    <hr />

    <dl class="row mt-4">
        <dt class="col-sm-3 fw-bold">@SR["ProjectName"]</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3 fw-bold">@SR["Customer"]</dt>
        <dd class="col-sm-9">@Model.Customer?.FirstName @Model.Customer?.LastName</dd>

        <dt class="col-sm-3 fw-bold">@SR["Status"]</dt>
        <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd>

        <dt class="col-sm-3 fw-bold">@SR["StartDate"]</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-3 fw-bold">@SR["Budget"]</dt>
        <dd class="col-sm-9">€@(Model.Budget?.ToString("G") ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["ProjectAddress"]</dt>
        <dd class="col-sm-9">@(Model.ProjectAddress ?? "-")</dd>
    </dl>

    <div class="mt-4 mb-5">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">@SR["BtnDelete"]</button>
            <a asp-action="Index" class="btn btn-secondary">@SR["BackToList"]</a>
        </form>
    </div>
</div>