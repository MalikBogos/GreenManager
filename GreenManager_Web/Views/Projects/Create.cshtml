@model GreenManager_Web.Models.ProjectCreateViewModel

@{
    ViewData["Title"] = SR["AddProject"];
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h2 text-dark fw-bold">@ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @SR["BackToList"]
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white fw-bold">
            Project &amp; Offerte Gegevens
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="row">
                    <!-- Projectnaam en Klant -->
                    <div class="col-md-6 mb-3">
                        <label for="Name" class="form-label fw-bold">@SR["ProjectName"] *</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="CustomerId" class="form-label fw-bold">@SR["Customer"] *</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select" required>
                            <option value="">-- Selecteer een klant --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <!-- Status, Datums en Budget -->
                    <div class="col-md-4 mb-3">
                        <label for="Status" class="form-label fw-bold">@SR["Status"]</label>
                        <!-- Genereert automatisch de ProjectStatus Enum -->
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<Models.Enums.ProjectStatus>()" class="form-select"></select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="StartDate" class="form-label fw-bold">@SR["StartDate"] *</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="EndDate" class="form-label fw-bold">@SR["EndDate"]</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="Budget" class="form-label fw-bold">@SR["Budget"]</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input asp-for="Budget" type="number" step="0.01" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="ProjectAddress" class="form-label fw-bold">@SR["ProjectAddress"]</label>
                        <input asp-for="ProjectAddress" class="form-control" />
                    </div>

                    <!-- Tekstvakken -->
                    <div class="col-12 mb-3">
                        <label for="Description" class="form-label fw-bold">@SR["Description"]</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12 mb-4">
                        <label for="Notes" class="form-label fw-bold">@SR["Notes"]</label>
                        <textarea asp-for="Notes" class="form-control bg-light" rows="2"></textarea>
                    </div>

                    <div class="col-12 text-end border-top pt-3">
                        <button type="submit" class="btn btn-success px-4 fw-bold">@SR["Save"]</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}