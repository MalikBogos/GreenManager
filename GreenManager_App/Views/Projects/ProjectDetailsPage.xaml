<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GreenManager_App.ViewModels"
             x:Class="GreenManager_App.Views.Projects.ProjectDetailsPage"
             x:DataType="viewmodels:ProjectsViewModel"
             Title="Project Details">

	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="15">
			<Label Text="{Binding SelectedProject.Name}" FontSize="24" FontAttributes="Bold" TextColor="DarkGreen" />

			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Algemeen:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedProject.CustomerLastName, StringFormat='Klant: {0}'}" />
					<Label Text="{Binding SelectedProject.Status, StringFormat='Status: {0}'}" />
					<Label Text="{Binding SelectedProject.ProjectAddress, StringFormat='Adres: {0}'}" />
				</VerticalStackLayout>
			</Border>

			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Financieel &amp; Planning:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedProject.Budget, StringFormat='Budget: €{0}'}" />
					<Label Text="{Binding SelectedProject.StartDate, StringFormat='Startdatum: {0:dd/MM/yyyy}'}" />
					<Label Text="{Binding SelectedProject.EndDate, StringFormat='Einddatum: {0:dd/MM/yyyy}'}" />
				</VerticalStackLayout>
			</Border>

			<Border Padding="15" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
				<VerticalStackLayout Spacing="5">
					<Label Text="Informatie:" FontAttributes="Bold" TextColor="DarkGreen" />
					<Label Text="{Binding SelectedProject.Description, StringFormat='Beschrijving: {0}'}" />
					<Label Text="{Binding SelectedProject.Notes, StringFormat='Notities: {0}'}" Margin="0,10,0,0"/>
				</VerticalStackLayout>
			</Border>

			<Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,20,0,0">
				<Button Grid.Column="0" Text="Bewerken" Command="{Binding NavigateToEditProjectCommand}" BackgroundColor="Orange" TextColor="White" />
				<Button Grid.Column="1" Text="Verwijderen" Command="{Binding DeleteProjectCommand}" BackgroundColor="DarkRed" TextColor="White" />
			</Grid>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>