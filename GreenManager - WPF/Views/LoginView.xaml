<UserControl x:Class="GreenManager___WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

	<Grid>
		<!-- Gecentreerd inlogvenster -->
		<Border Width="400" Height="450" Background="White" CornerRadius="10" 
                VerticalAlignment="Center" HorizontalAlignment="Center">

			<!-- Schaduw effect -->
			<Border.Effect>
				<DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1"/>
			</Border.Effect>

			<StackPanel Margin="40">
				<TextBlock Text="🌱 GreenManager" FontSize="28" FontWeight="Bold" 
                           Foreground="#27AE60" HorizontalAlignment="Center" Margin="0,0,0,10"/>

				<TextBlock Text="Welkom terug! Log in om verder te gaan." 
                           Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,40"/>

				<!-- E-mailadres Veld -->
				<TextBlock Text="E-mailadres" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<TextBox Text="{Binding EmailInput}" Padding="10" Margin="0,0,0,20" 
                         BorderThickness="1" BorderBrush="#DCDDE1" FontSize="14"/>

				<!-- Wachtwoord Veld -->
				<TextBlock Text="Wachtwoord" FontWeight="SemiBold" Margin="0,0,0,5"/>
				<!-- Let op: Een PasswordBox heeft standaard geen {Binding}. We geven hem een naam (x:Name) -->
				<PasswordBox x:Name="TxtPassword" Padding="10" Margin="0,0,0,10" 
                             BorderThickness="1" BorderBrush="#DCDDE1" FontSize="14"/>

				<!-- Foutmelding tekst (onzichtbaar tenzij er een fout is) -->
				<TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" 
                           FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20" TextWrapping="Wrap"/>

				<!-- Inlog Knop -->
				<Button Content="Inloggen" Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=TxtPassword}"
                        Padding="15" Background="#2C3E50" Foreground="White" 
                        FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>