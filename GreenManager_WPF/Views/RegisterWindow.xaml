<Window x:Class="GreenManager_WPF.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registreren - GreenManager" 
        Height="650" Width="450" 
        WindowStartupLocation="CenterScreen" 
        Background="White"
        ResizeMode="NoResize">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="30">
			<StackPanel VerticalAlignment="Center">
				<TextBlock Text="Nieuw Account" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Center"/>

				<TextBlock Text="Voornaam *"/>
				<TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

				<TextBlock Text="Achternaam *"/>
				<TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

				<TextBlock Text="E-mailadres *" />
				<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

				<TextBlock Text="Wachtwoord *"/>
				<PasswordBox x:Name="TxtPassword" PasswordChanged="TxtPassword_PasswordChanged"/>

				<TextBlock Text="Wachtwoord Bevestigen *"/>
				<PasswordBox x:Name="TxtConfirmPassword" PasswordChanged="TxtConfirmPassword_PasswordChanged"/>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="DarkRed" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

				<Button Content="Registreren" Command="{Binding RegisterCommand}" 
                        Style="{StaticResource SaveButtonStyle}" Width="Auto" HorizontalAlignment="Stretch"/>
			</StackPanel>
		</Grid>
	</ScrollViewer>
</Window>