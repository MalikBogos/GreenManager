<Window x:Class="GreenManager_WPF.Views.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nieuwe Werknemer Toevoegen" Height="650" Width="500"
        WindowStartupLocation="CenterOwner" Background="White"
        ResizeMode="NoResize">

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,20">
			<TextBlock Text="Nieuwe Werknemer" Style="{StaticResource HeaderStyle}"/>
		</StackPanel>

		<StackPanel Grid.Row="1">
			<TextBlock Text="Personeelsnummer (Automatisch)" Foreground="Gray"/>
			<TextBox Text="{Binding NewEmployee.EmployeeNumber}" IsReadOnly="True" Background="LightGray" Foreground="Gray"/>

			<TextBlock Text="Voornaam *"/>
			<TextBox Text="{Binding UserFirstName, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Text="Achternaam *"/>
			<TextBox Text="{Binding UserLastName, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Text="E-mailadres (Voor inloggen) *"/>
			<TextBox Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}"/>

			<TextBlock Text="Functie (Job Title) *"/>
			<TextBox Text="{Binding NewEmployee.JobTitle}"/>

			<TextBlock Text="Datum indiensttreding *"/>
			<DatePicker SelectedDate="{Binding NewEmployee.HireDate}"/>
		</StackPanel>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="Annuleren" Style="{StaticResource CancelButtonStyle}" Click="BtnCancel_Click"/>
			<Button Content="Opslaan" Style="{StaticResource SaveButtonStyle}" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>