@{
    ViewData["Title"] = SR["AccessDeniedTitle"];
}
<div class="container mt-5 text-center">
    <div class="mb-4">
        <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
    </div>
    <h1 class="text-danger fw-bold">@SR["AccessDeniedTitle"]</h1>
    <p class="lead mt-3 text-muted">@SR["AccessDeniedMessage"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">@SR["BackToHome"]</a>
</div>