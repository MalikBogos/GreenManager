<Window x:Class="GreenManager_WPF.Views.EditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Bewerken" Height="750" Width="900"
        WindowStartupLocation="CenterOwner" Background="White">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,15">
			<TextBlock Text="Project Details &amp; Beheer" Style="{StaticResource HeaderStyle}"/>
			<TextBlock Text="{Binding EditedProject.Name}" Foreground="Gray" FontWeight="Normal" Margin="0,-10,0,0"/>
		</StackPanel>

		<TabControl Grid.Row="1" Background="White" BorderBrush="#DCDDE1" Padding="10">
			<!-- TAB 1: ALGEMEEN -->
			<TabItem Header="Algemeen &amp; Status" FontSize="14" FontWeight="SemiBold">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid Margin="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="20"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0">
							<TextBlock Text="Projectnaam *"/>
							<TextBox Text="{Binding EditedProject.Name}"/>

							<TextBlock Text="Gekoppelde Klant (Niet bewerkbaar)"/>
							<ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedValue="{Binding EditedProject.CustomerId}" SelectedValuePath="Id" DisplayMemberPath="LastName" IsEnabled="False"/>

							<TextBlock Text="Project Adres"/>
							<TextBox Text="{Binding EditedProject.ProjectAddress}"/>

							<TextBlock Text="Korte Omschrijving"/>
							<TextBox Text="{Binding EditedProject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top"/>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Text="Status"/>
							<ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditedProject.Status}"/>

							<Grid Margin="0,0,0,15">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="10"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Startdatum"/>
									<DatePicker SelectedDate="{Binding EditedProject.StartDate}"/>
								</StackPanel>
								<StackPanel Grid.Column="2">
									<TextBlock Text="Einddatum (Optioneel)"/>
									<DatePicker SelectedDate="{Binding EditedProject.EndDate}"/>
								</StackPanel>
							</Grid>

							<TextBlock Text="Budget / Offertebedrag (€)"/>
							<TextBox Text="{Binding EditedProject.Budget}"/>

							<TextBlock Text="Interne Notities"/>
							<TextBox Text="{Binding EditedProject.Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top"/>
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</TabItem>

			<!-- TAB 2: PLANNING -->
			<TabItem Header="Planning (Medewerkers)" FontSize="14" FontWeight="SemiBold">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Border Grid.Row="0" Padding="10">
						<StackPanel Orientation="Horizontal">
							<StackPanel Margin="0,0,10,0" Width="200">
								<TextBlock Text="Werknemer"/>
								<ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedValue="{Binding SelectedEmployeeId}" SelectedValuePath="Id" DisplayMemberPath="User.LastName"/>
							</StackPanel>
							<StackPanel Margin="0,0,10,0" Width="150">
								<TextBlock Text="Geplande Datum"/>
								<DatePicker SelectedDate="{Binding NewPlannedDate}"/>
							</StackPanel>
							<StackPanel Margin="0,0,10,0" Width="100">
								<TextBlock Text="Geschatte Uren"/>
								<TextBox Text="{Binding NewEstimatedHours}"/>
							</StackPanel>
							<Button Content="Toevoegen" Style="{StaticResource AddButtonStyle}" Command="{Binding AddEmployeeCommand}" Margin="10,20,0,0"/>
						</StackPanel>
					</Border>
					<DataGrid Grid.Row="1" ItemsSource="{Binding ProjectEmployees}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Werknemer" Binding="{Binding Employee.User.LastName}" Width="200"/>
							<DataGridTextColumn Header="Datum" Binding="{Binding PlannedDate, StringFormat=dd-MM-yyyy}" Width="150"/>
							<DataGridTextColumn Header="Geschatte Uren" Binding="{Binding EstimatedHours}" Width="150"/>
							<DataGridTemplateColumn Width="50">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Button Content="🗑" Background="Transparent" Foreground="Red" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteProjectEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</TabItem>

			<!-- TAB 3: MATERIAAL -->
			<TabItem Header="Materialen" FontSize="14" FontWeight="SemiBold">
				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Border Grid.Row="0" Padding="10">
						<StackPanel Orientation="Horizontal">
							<StackPanel Margin="0,0,10,0" Width="250">
								<TextBlock Text="Materiaal"/>
								<ComboBox ItemsSource="{Binding AvailableMaterials}" SelectedValue="{Binding SelectedMaterialId}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
							</StackPanel>
							<StackPanel Margin="0,0,10,0" Width="100">
								<TextBlock Text="Hoeveelheid"/>
								<TextBox Text="{Binding NewQuantity}"/>
							</StackPanel>
							<Button Content="Toevoegen" Style="{StaticResource AddButtonStyle}" Command="{Binding AddMaterialCommand}" Margin="10,20,0,0"/>
						</StackPanel>
					</Border>
					<DataGrid Grid.Row="1" ItemsSource="{Binding ProjectMaterials}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Materiaal" Binding="{Binding Material.Name}" Width="300"/>
							<DataGridTextColumn Header="Eenheid" Binding="{Binding Material.Unit}" Width="100"/>
							<DataGridTextColumn Header="Hoeveelheid" Binding="{Binding Quantity}" Width="150"/>
							<DataGridTemplateColumn Width="50">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Button Content="🗑" Background="Transparent" Foreground="Red" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteProjectMaterialCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</TabItem>

			<!-- TAB 4: WERKUREN -->
			<TabItem Header="Geregistreerde Werkuren" FontSize="14" FontWeight="SemiBold">
				<Grid Margin="10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="156*"/>
						<ColumnDefinition Width="253*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Border Grid.Row="0" Padding="10" Grid.ColumnSpan="2">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
								<StackPanel Margin="0,0,10,0" Width="200">
									<TextBlock Text="Werknemer"/>
									<ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedValue="{Binding SelectedWorkEmployeeId}" SelectedValuePath="Id" DisplayMemberPath="User.LastName"/>
								</StackPanel>
								<StackPanel Margin="0,0,10,0" Width="150">
									<TextBlock Text="Gewerkte Datum"/>
									<DatePicker SelectedDate="{Binding NewWorkDate}"/>
								</StackPanel>
								<StackPanel Margin="0,0,10,0" Width="100">
									<TextBlock Text="Aantal Uren"/>
									<TextBox Text="{Binding NewHoursWorked}"/>
								</StackPanel>
							</StackPanel>
							<StackPanel Grid.Row="1" Orientation="Horizontal">
								<StackPanel Margin="0,0,10,0" Width="460">
									<TextBlock Text="Omschrijving van het werk"/>
									<TextBox Text="{Binding NewTaskDescription}"/>
								</StackPanel>
								<Button Content="Uren Boeken" Style="{StaticResource AddButtonStyle}" Command="{Binding AddWorkLogCommand}" Margin="10,18,0,0"/>
							</StackPanel>
						</Grid>
					</Border>
					<DataGrid ItemsSource="{Binding WorkLogs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Grid.ColumnSpan="2" Margin="0,187,0,0" Grid.RowSpan="2">
						<DataGrid.Columns>
							<DataGridTextColumn Header="Datum" Binding="{Binding WorkDate, StringFormat=dd-MM-yyyy}" Width="100"/>
							<DataGridTextColumn Header="Werknemer" Binding="{Binding Employee.User.LastName}" Width="150"/>
							<DataGridTextColumn Header="Omschrijving" Binding="{Binding TaskDescription}" Width="250"/>
							<DataGridTextColumn Header="Uren" Binding="{Binding HoursWorked}" Width="70"/>
							<DataGridTextColumn Header="Loonkost" Binding="{Binding LaborCost, StringFormat={}{0:C}}" Width="100"/>
							<DataGridTemplateColumn Width="50">
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<Button Content="🗑" Background="Transparent" Foreground="Red" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteWorkLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</TabItem>
		</TabControl>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="Annuleren" Style="{StaticResource CancelButtonStyle}" Click="BtnCancel_Click"/>
			<Button Content="Opslaan" Style="{StaticResource SaveButtonStyle}" Click="BtnSave_Click"/>
		</StackPanel>
	</Grid>
</Window>