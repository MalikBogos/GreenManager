@model Models.Entities.Customer

@{
    ViewData["Title"] = SR["BtnDelete"];
}

<div class="container mt-4">
    <h2 class="text-danger">@ViewData["Title"]</h2>
    <h4>@SR["AreYouSureDelete"]</h4>
    <hr />
    
    <dl class="row mt-4">
        <dt class="col-sm-3 fw-bold">@SR["FirstName"]</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3 fw-bold">@SR["LastName"]</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3 fw-bold">@SR["CompanyName"]</dt>
        <dd class="col-sm-9">@(Model.CompanyName ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["VATNumber"]</dt>
        <dd class="col-sm-9">@(Model.VATNumber ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["Email"]</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3 fw-bold">@SR["PhoneNumber"]</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>
        
        <dt class="col-sm-3 fw-bold">@SR["Street"]</dt>
        <dd class="col-sm-9">@(Model.Street ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["PostalCode"]</dt>
        <dd class="col-sm-9">@(Model.PostalCode ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["City"]</dt>
        <dd class="col-sm-9">@(Model.City ?? "-")</dd>

        <dt class="col-sm-3 fw-bold">@SR["Notes"]</dt>
        <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
    </dl>
    
    <div class="mt-4 mb-5">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">@SR["BtnDelete"]</button>
            <a asp-action="Index" class="btn btn-secondary">@SR["BackToList"]</a>
        </form>
    </div>
</div>