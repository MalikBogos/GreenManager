@model IEnumerable<Models.Entities.Employee>

@{
    ViewData["Title"] = SR["NavEmployees"];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-success">@SR["AddEmployee"]</a>
    </div>

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-light">
            <tr>
                <th>@SR["EmployeeNumber"]</th>
                <th>@SR["FirstName"]</th>
                <th>@SR["LastName"]</th>
                <th>@SR["JobTitle"]</th>
                <th>@SR["HourlyWage"]</th>
                <th>@SR["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        Geen werknemers gevonden in het systeem.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.EmployeeNumber</td>
                        <!-- Via Entity Framework relatie ophalen we de gegevens uit ApplicationUser -->
                        <td>@item.User?.FirstName</td>
                        <td>@item.User?.LastName</td>
                        <td>@item.JobTitle</td>
                        <td>€@item.HourlyWage.ToString("G")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@SR["BtnEdit"]</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">@SR["Details"]</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@SR["BtnDelete"]</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>