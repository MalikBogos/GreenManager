@model IEnumerable<Models.Entities.Project>

@{
    ViewData["Title"] = SR["NavProjects"];
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-success">@SR["AddProject"]</a>
    </div>

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-light">
            <tr>
                <th>@SR["ProjectName"]</th>
                <th>@SR["Customer"]</th>
                <th>@SR["Status"]</th>
                <th>@SR["StartDate"]</th>
                <th>@SR["EndDate"]</th>
                <th>@SR["Budget"]</th>
                <th>@SR["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Name</td>
                    <td>@item.Customer?.LastName</td>
                    <td><span class="badge bg-secondary">@item.Status</span></td>
                    <td>@item.StartDate.ToString("dd-MM-yyyy")</td>
                    <td>@(item.EndDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                    <td>€@(item.Budget?.ToString("G") ?? "-")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">@SR["BtnEdit"]</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">@SR["Details"]</a>
                        @if(User.IsInRole("Admin")){
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">@SR["BtnDelete"]</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>