<Window x:Class="GreenManager___WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="clr-namespace:GreenManager___WPF.Views"
        Title="GreenManager" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
		<Style x:Key="NavButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#ECF0F1"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Margin" Value="10,5"/>
			<Setter Property="Padding" Value="15,10"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#34495E"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="#2C3E50">
			<StackPanel Margin="0,20,0,0">
				<TextBlock Text="🌱 GreenManager" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,0,0,40"/>

				<Button Content="🏠  Dashboard" Style="{StaticResource NavButton}" Click="BtnDashboard_Click"/>
				<Button Content="👥  Klanten" Visibility="{Binding IsNotGuest, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnClients_Click"/>
				<Button Content="📁  Projecten" Visibility="{Binding IsNotGuest, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnProjects_Click"/>
				<Button Content="📦  Materiaal" Visibility="{Binding IsNotGuest, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnMaterials_Click"/>
				<Button Content="👷  Werknemers" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnEmployees_Click"/>
				<Button Content="⚙️  Instellingen" Style="{StaticResource NavButton}" Click="BtnSettings_Click"/>

				<Button Content="🚪  Uitloggen" Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}" Margin="10,40,10,5"/>
			</StackPanel>
		</Border>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="70"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
				<Grid>
					<TextBlock VerticalAlignment="Center" Margin="30,0,0,0" FontSize="16" FontWeight="SemiBold">
						Welkom,
						<Run Text="{Binding CurrentUserRole}" Foreground="DodgerBlue" FontWeight="Bold" />
						<Run Text="{Binding CurrentUser.FirstName}" Foreground="DarkOrange" FontWeight="Bold"/>!
					</TextBlock>
				</Grid>
			</Border>

			<ContentControl x:Name="MainContent" Grid.Row="1" Margin="30">
				<Border Background="White" CornerRadius="10" Padding="50">
					<TextBlock Text="Welkom bij GreenManager. Kies een optie in het menu." 
                               Foreground="#7F8C8D" FontSize="18" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
			</ContentControl>
			

		</Grid>
	</Grid>
</Window>