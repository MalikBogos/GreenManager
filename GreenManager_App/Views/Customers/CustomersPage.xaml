<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GreenManager_App.ViewModels"
             xmlns:models="clr-namespace:Models.Entities;assembly=Models"
             x:Class="GreenManager_App.Views.Customers.CustomersPage"
             x:Name="RootPage"
             x:DataType="viewmodels:CustomersViewModel"
             Title="Klantenoverzicht">

	<Grid RowDefinitions="Auto, Auto, *">

		<Button Grid.Row="0"
                Text="+ Nieuwe Klant" 
                Command="{Binding NavigateToAddCustomerCommand}" 
                Padding="10,10,10,10"
                Margin="15,15,15,5" 
                BackgroundColor="DarkGreen" 
                TextColor="White" />

		<Picker Grid.Row="1" 
                Title="Kies een filter..." 
                ItemsSource="{Binding FilterOptions}" 
                SelectedItem="{Binding SelectedFilter}" 
                Margin="15,5,15,10" />

		<CollectionView Grid.Row="2" ItemsSource="{Binding Customers}">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:Customer">
					<Border Margin="15,0,15,10" Padding="15" BackgroundColor="#F5F5F5">

						<Border.GestureRecognizers>
							<TapGestureRecognizer 
								Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.NavigateToDetailsCommand}" 
								CommandParameter="{Binding .}" />
						</Border.GestureRecognizers>

						<VerticalStackLayout>
							<Label Text="{Binding FirstName}" FontSize="18" FontAttributes="Bold" TextColor="DarkGreen"/>
							<Label Text="{Binding LastName}" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen"/>
							<Label Text="{Binding Email}" FontSize="14" TextColor="Gray" />
							<Label Text="{Binding City}" FontSize="14" TextColor="Gray" />
						</VerticalStackLayout>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<ActivityIndicator Grid.Row="0" Grid.RowSpan="3"
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Color="DarkGreen" />
	</Grid>
</ContentPage>