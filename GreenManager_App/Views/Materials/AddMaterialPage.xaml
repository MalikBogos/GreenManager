<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GreenManager_App.ViewModels"
             x:Class="GreenManager_App.Views.Materials.AddMaterialPage"
             x:DataType="viewmodels:MaterialsViewModel"
             Title="Nieuw Materiaal">
	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="15">
			<Label Text="Materiaalinformatie" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen" />
			<Entry Placeholder="Naam *" Text="{Binding NewName}" />
			<Entry Placeholder="Eenheid (bijv. stuks, m2)" Text="{Binding NewUnit}" />

			<Label Text="Financieel &amp; Voorraad" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen" Margin="0,10,0,0"/>
			<Entry Placeholder="Aankoopprijs (€)" Text="{Binding NewPurchasePrice}" Keyboard="Numeric" />
			<Entry Placeholder="Huidige Voorraad" Text="{Binding NewStockQuantity}" Keyboard="Numeric" />

			<Label Text="Extra Details" FontSize="16" FontAttributes="Bold" TextColor="DarkGreen" Margin="0,10,0,0"/>
			<Editor Placeholder="Korte omschrijving" Text="{Binding NewDescription}" HeightRequest="60" />
			<Editor Placeholder="Notities" Text="{Binding NewNotes}" HeightRequest="100" />

			<Label Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" FontAttributes="Bold" />
			<Button Text="Opslaan" Command="{Binding SaveMaterialCommand}" BackgroundColor="#81C784" TextColor="Black" CornerRadius="8" Margin="0,15,0,20"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>