<Window x:Class="GreenManager___WPF.Views.EditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Bewerken" Height="750" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="⚙️ Project Details &amp; Beheer" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding EditedProject.Name}" FontSize="16" Foreground="#7F8C8D"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#DCDDE1" Padding="10">
            
            <!-- TAB 1: ALGEMEEN -->
            <TabItem Header="Algemeen &amp; Status" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Projectnaam *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EditedProject.Name}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                            <TextBlock Text="Gekoppelde Klant *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableCustomers}" SelectedValue="{Binding EditedProject.CustomerId}" SelectedValuePath="Id" DisplayMemberPath="LastName" Padding="6" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                            <TextBlock Text="Project Adres" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EditedProject.ProjectAddress}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                            <TextBlock Text="Korte Omschrijving" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EditedProject.Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableStatuses}" SelectedItem="{Binding EditedProject.Status}" Padding="6" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Startdatum" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding EditedProject.StartDate}" Padding="5" BorderThickness="1" BorderBrush="#DCDDE1"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Einddatum (Optioneel)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding EditedProject.EndDate}" Padding="5" BorderThickness="1" BorderBrush="#DCDDE1"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Budget / Offertebedrag (€)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EditedProject.Budget}" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                            <TextBlock Text="Interne Notities" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EditedProject.Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top" Padding="8" Margin="0,0,0,15" BorderThickness="1" BorderBrush="#DCDDE1"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: PLANNING -->
            <TabItem Header="Planning (Medewerkers)" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F6FA" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0" Width="200">
                                <TextBlock Text="Werknemer" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedValue="{Binding SelectedEmployeeId}" SelectedValuePath="Id" DisplayMemberPath="User.LastName" Padding="6"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0" Width="150">
                                <TextBlock Text="Geplande Datum" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding NewPlannedDate}" Padding="5"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0" Width="100">
                                <TextBlock Text="Geschatte Uren" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewEstimatedHours}" Padding="6"/>
                            </StackPanel>
                            <Button Content="Toevoegen" Background="#2980B9" Foreground="White" FontWeight="Bold" Padding="15,0" Margin="10,20,0,0" BorderThickness="0" Cursor="Hand" Command="{Binding AddEmployeeCommand}"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProjectEmployees}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Werknemer" Binding="{Binding Employee.User.LastName}" Width="200"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding PlannedDate, StringFormat=dd-MM-yyyy}" Width="150"/>
                            <DataGridTextColumn Header="Geschatte Uren" Binding="{Binding EstimatedHours}" Width="150"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteProjectEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: MATERIALEN -->
            <TabItem Header="Materialen" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F6FA" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0" Width="250">
                                <TextBlock Text="Materiaal" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding AvailableMaterials}" SelectedValue="{Binding SelectedMaterialId}" SelectedValuePath="Id" DisplayMemberPath="Name" Padding="6"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0" Width="100">
                                <TextBlock Text="Aantal / Hoeveelheid" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewQuantity}" Padding="6"/>
                            </StackPanel>
                            <Button Content="Toevoegen" Background="#2980B9" Foreground="White" FontWeight="Bold" Padding="15,0" Margin="10,20,0,0" BorderThickness="0" Cursor="Hand" Command="{Binding AddMaterialCommand}"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProjectMaterials}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Materiaal" Binding="{Binding Material.Name}" Width="300"/>
                            <DataGridTextColumn Header="Eenheid" Binding="{Binding Material.Unit}" Width="100"/>
                            <DataGridTextColumn Header="Hoeveelheid" Binding="{Binding Quantity}" Width="150"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteProjectMaterialCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: WERKUREN -->
            <TabItem Header="Geregistreerde Werkuren" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F5F6FA" Padding="10" Margin="0,0,0,15" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <StackPanel Margin="0,0,10,0" Width="200">
                                    <TextBlock Text="Werknemer" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding AvailableEmployees}" SelectedValue="{Binding SelectedWorkEmployeeId}" SelectedValuePath="Id" DisplayMemberPath="User.LastName" Padding="6"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Width="150">
                                    <TextBlock Text="Gewerkte Datum" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <DatePicker SelectedDate="{Binding NewWorkDate}" Padding="5"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0" Width="100">
                                    <TextBlock Text="Aantal Uren" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewHoursWorked}" Padding="6"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <StackPanel Margin="0,0,10,0" Width="460">
                                    <TextBlock Text="Omschrijving van het werk" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding NewTaskDescription}" Padding="6"/>
                                </StackPanel>
                                <Button Content="Uren Boeken" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="15,0" Margin="10,18,0,0" BorderThickness="0" Cursor="Hand" Command="{Binding AddWorkLogCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WorkLogs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datum" Binding="{Binding WorkDate, StringFormat=dd-MM-yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Werknemer" Binding="{Binding Employee.User.LastName}" Width="150"/>
                            <DataGridTextColumn Header="Omschrijving" Binding="{Binding TaskDescription}" Width="250"/>
                            <DataGridTextColumn Header="Uren" Binding="{Binding HoursWorked}" Width="70"/>
                            <DataGridTextColumn Header="Loonkost" Binding="{Binding LaborCost, StringFormat={}{0:C}}" Width="100"/>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.DeleteWorkLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuleren" Width="100" Padding="10" Margin="0,0,10,0" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="Project Opslaan" Width="130" Padding="10" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>