<Window x:Class="GreenManager_WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GreenManager" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="White">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>

		<Style x:Key="NavButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Margin" Value="10,5"/>
			<Setter Property="Padding" Value="15,10"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="SlateGray"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="DarkGray">
			<StackPanel Margin="0,20,0,0">
				<TextBlock Text="GreenManager" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,0,0,40"/>

				<Button Content="Dashboard" Style="{StaticResource NavButton}" Click="BtnDashboard_Click"/>
				<Button Content="Klanten" Visibility="{Binding IsNotGuest, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnClients_Click"/>
				<Button Content="Projecten" Visibility="{Binding IsNotGuest, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnProjects_Click"/>
				<Button Content="Materiaal" Visibility="{Binding IsNotGuest, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnMaterials_Click"/>
				<Button Content="Werknemers" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" Style="{StaticResource NavButton}" Click="BtnEmployees_Click"/>

				<Button Content="Uitloggen" Style="{StaticResource NavButton}" Command="{Binding LogoutCommand}" Margin="10,40,10,5"/>
			</StackPanel>
		</Border>

		<Grid Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition Height="70"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Background="White" BorderBrush="LightGray" BorderThickness="0,0,0,1">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
					<TextBlock Text="Welkom, " FontSize="16" FontWeight="SemiBold"/>
					<TextBlock Text="{Binding CurrentUserRole}" Foreground="SteelBlue" FontWeight="Bold" FontSize="16"/>
					<TextBlock Text="{Binding CurrentUser.FirstName, StringFormat=' {0}!'}" Foreground="DarkOrange" FontWeight="Bold" FontSize="16"/>
				</StackPanel>
			</Border>

			<!-- Wisselende Pagina Content -->
			<ContentControl x:Name="MainContent" Grid.Row="1" Margin="30">
				<Border Background="White" CornerRadius="10" Padding="50">
					<TextBlock Text="GreenManager" Foreground="Gray" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
			</ContentControl>
		</Grid>
	</Grid>
</Window>