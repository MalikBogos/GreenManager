@using Microsoft.AspNetCore.Identity
@using Models.Entities

@* We injecteren de managers om te kunnen checken of iemand is ingelogd *@
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center me-3">
            <span class="text-dark fw-bold">Hallo @User.Identity?.Name!</span>
        </li>
        <li class="nav-item">
            @* Uitloggen MOET via een formulier met POST methode *@
            <form asp-controller="Accounts" asp-action="Logout" method="post" class="form-inline">
                <button type="submit" class="nav-link btn btn-link text-danger fw-bold border-0 bg-transparent">@SR["NavLogout"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-primary fw-bold" asp-controller="Accounts" asp-action="Register">@SR["NavRegister"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-success fw-bold" asp-controller="Accounts" asp-action="Login">@SR["NavLogin"]</a>
        </li>
    }
</ul>