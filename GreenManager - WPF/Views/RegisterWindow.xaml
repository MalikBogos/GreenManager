<Window x:Class="GreenManager___WPF.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registreren - GreenManager" Height="600" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">

	<Grid Margin="40">
		<StackPanel VerticalAlignment="Center">
			<TextBlock Text="Nieuw Account" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,25"/>

			<TextBlock Text="Voornaam" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Achternaam" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderBrush="#DCDDE1"/>

			<TextBlock Text="E-mailadres" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Wachtwoord" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderBrush="#DCDDE1"/>

			<TextBlock Text="Wachtwoord Bevestigen" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
			<TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" BorderBrush="#DCDDE1"/>

			<TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

			<Button Content="Registreren" Command="{Binding RegisterCommand}" 
                    Background="#27AE60" Foreground="White" Padding="10" 
                    FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
		</StackPanel>
	</Grid>
</Window>